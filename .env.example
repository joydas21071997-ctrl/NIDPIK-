# ==============================================================================
# NIDPIK ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env and configure your secret credentials.
# NEVER commit real passwords or emails to Git.
# ==============================================================================

# Gemini AI API Key
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Admin CMS Superadmin Credentials
ADMIN_OWNER_EMAIL="admin@example.com"
ADMIN_OWNER_PASSWORD="your-strong-random-password-here"
ADMIN_SECONDARY_EMAIL=""
ADMIN_ALLOWED_EMAILS="admin@example.com"

# Application URL
APP_URL="http://localhost:3000"
