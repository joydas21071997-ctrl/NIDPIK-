rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // PRODUCTS
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn() && isValidId(productId);

      // PRODUCT REVIEWS
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isValidId(reviewId) &&
          request.resource.data.keys().hasAll(['productId', 'authorName', 'rating', 'comment']) &&
          request.resource.data.rating is number &&
          request.resource.data.rating >= 1 &&
          request.resource.data.rating <= 5 &&
          request.resource.data.authorName is string &&
          request.resource.data.authorName.size() <= 100 &&
          request.resource.data.comment is string &&
          request.resource.data.comment.size() <= 2000;
        allow update, delete: if isSignedIn();
      }
    }

    // CATEGORIES
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn() && isValidId(categoryId);
    }

    // PRICE ALERTS
    match /price_alerts/{alertId} {
      allow read: if isSignedIn();
      allow create: if isValidId(alertId) &&
        request.resource.data.keys().hasAll(['productId', 'email', 'targetPrice']) &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 150 &&
        request.resource.data.targetPrice is number &&
        request.resource.data.targetPrice > 0;
      allow update, delete: if isSignedIn();
    }

    // USERS (Admin & Editor Profiles)
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
