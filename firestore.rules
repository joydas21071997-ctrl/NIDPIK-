rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // PRODUCTS (Public read, verified id write for catalog)
    match /products/{productId} {
      allow read: if true;
      allow write: if isValidId(productId);

      // PRODUCT REVIEWS
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isValidId(reviewId) &&
          request.resource.data.keys().hasAll(['productId', 'authorName', 'rating', 'comment']) &&
          request.resource.data.rating is number &&
          request.resource.data.rating >= 1 &&
          request.resource.data.rating <= 5;
        allow update, delete: if true;
      }
    }

    // ARTICLES
    match /articles/{articleId} {
      allow read: if true;
      allow write: if isValidId(articleId);
    }

    // BUYING GUIDES
    match /buying_guides/{guideId} {
      allow read: if true;
      allow write: if isValidId(guideId);
    }

    // CATEGORIES
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isValidId(categoryId);
    }

    // MEDIA LIBRARY (Uploaded Cloud Images & metadata)
    match /media/{mediaId} {
      allow read: if true;
      allow write: if isValidId(mediaId);
    }

    // PRICE ALERTS
    match /price_alerts/{alertId} {
      allow read: if true;
      allow create: if isValidId(alertId) &&
        request.resource.data.keys().hasAll(['productId', 'email', 'targetPrice']) &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 150;
      allow update, delete: if true;
    }

    // NEWSLETTER SUBSCRIBERS
    match /newsletter_subscribers/{subscriberId} {
      allow read: if true;
      allow create: if isValidId(subscriberId) &&
        request.resource.data.keys().hasAll(['email']) &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 150;
      allow update, delete: if true;
    }

    // USERS (Admin Profiles)
    match /users/{userId} {
      allow read, write: if isValidId(userId);
    }
  }
}
